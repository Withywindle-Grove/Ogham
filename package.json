{
  "name": "grimoire",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Withywindle-Grove/Ogham.git"
  },
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run docs:check && node scripts/check-function-lineage.mjs && npm run build",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:push": "supabase db push --linked",
    "db:push:test": "node scripts/db-push-test.mjs",
    "seed:test": "node scripts/seed-test-campaigns.mjs",
    "db:types": "supabase gen types typescript --linked --schema public > src/core/database.types.ts",
    "test:layout": "playwright test",
    "db:backup": "node scripts/db-backup.mjs",
    "pack:check": "node scripts/check-pack.mjs",
    "names:check": "node scripts/check-names.mjs --all",
    "hooks:install": "git config core.hooksPath .githooks",
    "docs:gen": "node scripts/docs-gen.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "usage:report": "node scripts/usage-report.mjs"
  },
  "dependencies": {
    "@fontsource/alegreya-sans-sc": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/bitter": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "dexie": "^4.4.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "supabase": "^2.119.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
