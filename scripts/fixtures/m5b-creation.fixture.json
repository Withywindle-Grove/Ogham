{
  "format": "tabletop-pack",
  "formatVersion": 2,
  "meta": {
    "id": "fixture-fen-creation",
    "name": "Invented creation sample",
    "shortName": "Fen sample",
    "version": "0.1",
    "kind": "setting",
    "author": "Invented for the app's tests",
    "description": "An invented setting for testing guided creation (M5b step 0c): every creation rule as data, with made-up names and numbers."
  },
  "rulesSets": [
    {
      "id": "fen-rules",
      "name": "Fen rules",
      "abilities": [
        { "key": "MUS", "name": "Muscle", "short": "MUS", "blurb": "Lifting, hitting and holding a line." },
        { "key": "NIM", "name": "Nimbleness", "short": "NIM", "blurb": "Dodging, throwing and steady hands." },
        { "key": "GRT", "name": "Grit", "short": "GRT", "blurb": "Shrugging off cold, wounds and bad water." },
        { "key": "WIT", "name": "Wit", "short": "WIT", "blurb": "Reading, reckoning and extra tongues." },
        { "key": "LORE", "name": "Lore", "short": "LORE", "blurb": "Old knowledge and a feel for the uncanny." },
        { "key": "CHARM", "name": "Charm", "short": "CHARM", "blurb": "Talking the fen folk round." }
      ],
      "abilityModifiers": {
        "MUS": [
          { "range": "2-4", "melee": -2 },
          { "range": "5-7", "melee": -1 },
          { "range": "8-11", "melee": 0 },
          { "range": "12-14", "melee": 1 },
          { "range": "15-16", "melee": 2 }
        ],
        "NIM": [
          { "range": "2-4", "missile": -2, "ac": -1 },
          { "range": "5-7", "missile": -1, "ac": 0 },
          { "range": "8-11", "missile": 0, "ac": 0 },
          { "range": "12-14", "missile": 1, "ac": 1 },
          { "range": "15-16", "missile": 2, "ac": 1 }
        ],
        "GRT": [
          { "range": "2-4", "hp": -2 },
          { "range": "5-7", "hp": -1 },
          { "range": "8-11", "hp": 0 },
          { "range": "12-14", "hp": 1 },
          { "range": "15-16", "hp": 2 }
        ],
        "WIT": [
          { "range": "2-4", "extraLanguages": 0, "literacy": "Cannot read" },
          { "range": "5-7", "extraLanguages": 0, "literacy": "Reads slowly" },
          { "range": "8-11", "extraLanguages": 1, "literacy": "Reads" },
          { "range": "12-14", "extraLanguages": 2, "literacy": "Reads" },
          { "range": "15-16", "extraLanguages": 3, "literacy": "Reads and writes well" }
        ],
        "LORE": [
          { "range": "2-7", "saveBonus": -1 },
          { "range": "8-11", "saveBonus": 0 },
          { "range": "12-16", "saveBonus": 1 }
        ],
        "CHARM": [
          { "range": "2-4", "reaction": -2, "hirelings": 1 },
          { "range": "5-7", "reaction": -1, "hirelings": 2 },
          { "range": "8-11", "reaction": 0, "hirelings": 3 },
          { "range": "12-14", "reaction": 1, "hirelings": 4 },
          { "range": "15-16", "reaction": 2, "hirelings": 5 }
        ]
      },
      "primeRequisiteXp": [
        { "range": "2-4", "xp": -15 },
        { "range": "5-7", "xp": -10 },
        { "range": "8-11", "xp": 0 },
        { "range": "12-14", "xp": 5 },
        { "range": "15-16", "xp": 10 }
      ],
      "primeRequisiteRule": "lowest",
      "scores": {
        "dice": "2d8",
        "min": 2,
        "max": 16,
        "startOver": {
          "everyAtMost": 7,
          "countAtMost": { "count": 3, "value": 5 },
          "option": "fen-cruel-dice",
          "note": "If the dice were cruel, you may start over."
        }
      },
      "abilityAdjustment": {
        "lowerBy": 2,
        "raiseBy": 1,
        "lowerable": "nonPrime",
        "raise": "prime",
        "floor": 7,
        "cap": 15,
        "classExceptions": [{ "classId": "lantern-warden", "cannotLower": ["GRT"] }],
        "note": "Lower a score that isn't your prime by 2 to raise your prime by 1. Nothing goes under 7.",
        "source": "Fen rules p. 4"
      },
      "languages": {
        "common": ["fen-common"],
        "alignment": true,
        "list": [
          { "id": "fen-common", "name": "Fen common", "blurb": "What everyone in the fens speaks." },
          { "id": "reedspeak", "name": "Reedspeak", "blurb": "The whispering tongue of the reed cutters.", "source": "Fen rules p. 9" },
          { "id": "deep-croak", "name": "Deep croak", "blurb": "Bog folk's low talk; carries under water." },
          { "id": "old-lantern", "name": "Old lantern", "blurb": "The wardens' chant, half sung.", "note": "Only wardens learn it." }
        ],
        "extraFrom": "WIT"
      },
      "alignmentVisibility": "owner",
      "alignmentNotes": {
        "general": "Which way your character leans when the lights go out.",
        "Lantern": "Keeps the lights lit for everyone.",
        "Reed": "Bends with the wind.",
        "Mire": "Lets the dark in."
      },
      "alignmentBlurbs": {
        "Lantern": "Keeps the lights lit for everyone.",
        "Reed": "Bends with the wind.",
        "Mire": "Lets the dark in."
      },
      "hitPoints": { "startMinimum": 1, "minimumPerDie": 1, "reroll": { "atMost": 2, "option": "fen-second-wind", "note": "A 1 or 2 on the die: you may roll your hit points again." } },
      "attack": { "unarmouredAC": 10 },
      "weaponProficiency": {
        "option": "fen-weapon-drill",
        "note": "Pick the weapons your calling drilled with; any other is clumsier in your hands.",
        "byCategory": { "martial": { "start": 2, "gainEvery": 3, "penalty": -2 }, "gentle": { "start": 1, "gainEvery": 5, "penalty": -4 } },
        "specialisation": { "option": "fen-weapon-drill=on-drill-master", "categories": ["martial"], "cost": 2, "bonus": { "attack": 1, "damage": 1 }, "note": "Pick one weapon twice to master it: two picks for +1 to hit and +1 damage." },
        "restrictedWeapons": { "option": "fen-odd-weapons", "note": "A calling's forbidden weapons can be used with the same penalty." },
        "source": "Fen rules p. 22"
      },
      "byOption": {
        "fen-market=off": { "startingGear": { "shop": false }, "startingEquipment": ["rope-reed", "storm-lantern"] },
        "fen-two-bands=on": {
          "encumbrance": {
            "slot": {
              "bands": {
                "equipped": [{ "maxSlots": 2, "speed": "125 ft" }, { "maxSlots": 4, "speed": "50 ft" }],
                "stowed": [{ "maxSlots": 4, "speed": "125 ft" }, { "maxSlots": 6, "speed": "80 ft" }, { "maxSlots": 8, "speed": "20 ft" }]
              },
              "combine": "slowest"
            }
          }
        }
      },
      "startingMoney": "3d6 × 10 gp",
      "currency": [
        { "key": "gp", "label": "Gold", "valueInBase": 10 },
        { "key": "sp", "label": "Silver", "valueInBase": 1 }
      ],
      "itemCategories": [
        { "id": "weapon", "name": "Weapons", "order": 1 },
        { "id": "armour", "name": "Armour", "order": 2 },
        { "id": "gear", "name": "Adventuring gear", "order": 3 },
        { "id": "trinket", "name": "Trinkets", "order": 4, "unencumbering": true }
      ],
      "encumbrance": {
        "mode": "coin",
        "coin": {
          "coinsPerUnit": 1,
          "maxLoadCoin": 1200,
          "tiers": [
            { "label": "Light", "max": 450, "effect": "Normal pace", "movement": "125 ft" },
            { "label": "Laden", "max": 900, "effect": "Slowed", "movement": "80 ft" },
            { "label": "Weighed down", "max": 1200, "effect": "Crawling", "movement": "50 ft" }
          ],
          "overMax": "Can't move"
        },
        "slot": {
          "baseSlots": 10,
          "tiers": [
            { "label": "Nimble", "maxSlots": 5, "effect": "Normal pace", "movement": "125 ft" },
            { "label": "Burdened", "maxSlots": 10, "effect": "Slowed", "movement": "50 ft" }
          ],
          "overMax": "Can't move"
        }
      },
      "movement": { "default": 30, "exploration": "speed * 3", "partySpeed": "slowest member", "combat": { "formula": "speed / 3", "unit": "ft per round" } },
      "skills": [{ "id": "hark", "name": "Hark", "die": "d6", "default": 6, "rollMode": "equal-or-over", "fill": { "best": ["base", { "classSkill": "EAR" }] }, "notes": "Hearing what waits behind a door." }],
      "saveModifiers": [{ "id": "spell-ward", "name": "Spell ward", "value": { "from": "LORE", "plusRaceField": "spellWard" }, "notes": "The LORE modifier plus any kindred bonus." }],
      "creationGuide": {
        "scores": { "why": "Your scores shape what you're good at.", "help": "This decides which classes you can reach. Weigh Grit for hit points. If unsure, keep them as rolled." },
        "race": { "title": "Kindred", "why": "Your kindred sets what you can become.", "help": "This decides your level cap and your tongues. Weigh the score changes. If unsure, bog folk fit anyone." },
        "class": { "why": "Your calling is what you do when the lights fail.", "help": "This decides your hit die and your prime. Weigh what the table lacks. If unsure, a warden is forgiving." },
        "who": "A name the table will remember.",
        "spells": "The spells you carry out of your training.",
        "gear": "Buy what you carry into your first dive.",
        "languages": "Words you can speak and read in the fens."
      },
      "creation": { "require": ["languages"] },
      "levelUp": { "when": "downtime" },
      "xp": { "treasure": { "perGp": 1 }, "rounding": "nearest" },
      "weather": {
        "tables": { "any": "fen-sky" },
        "rollEvery": { "value": 1, "unit": "day" },
        "tags": {
          "wet": { "name": "Wet", "note": "Fires are hard to light" },
          "mired": { "name": "Mired", "budget": -2, "warn": "The ground sucks at every step" }
        }
      },
      "hunger": { "note": "A day without food: the hungry tire, and tire more each day." },
      "exploration": {
        "modes": [
          {
            "id": "fen-trek",
            "name": "Fen trek",
            "step": { "value": 1, "unit": "day" },
            "procedure": [
              { "id": "sky", "name": "Weather", "icon": "weather", "kind": "roll" },
              { "id": "astray", "name": "Going astray", "icon": "lost", "kind": "check", "checkId": "fen-astray" },
              { "id": "prowl", "name": "Prowlers", "icon": "monster", "kind": "check", "checkId": "fen-prowl" }
            ],
            "checks": [
              {
                "id": "fen-astray",
                "name": "Going astray",
                "every": { "value": 1, "unit": "day" },
                "chance": { "die": "d6", "on": [1] },
                "byTerrain": true,
                "terrainChance": "lostChance",
                "modifiers": [
                  { "routeType": "causeway", "never": true },
                  { "ifPartyHas": { "class": "reed-witch" }, "chance": { "on": [1] }, "onlyOnTerrain": ["reedbed"], "note": "Reed-reading: a party with a Reed Witch goes astray in reedbeds only on a 1." }
                ],
                "alsoWhen": { "leaveRoute": "causeway" },
                "onHit": { "tableId": "fen-astray-result" }
              },
              {
                "id": "fen-prowl",
                "name": "Prowlers",
                "every": { "value": 1, "unit": "day" },
                "chance": { "die": "d6", "on": [1] },
                "byTerrain": true,
                "terrainChance": "wanderChance",
                "onHit": { "tableId": "fen-prowlers" }
              }
            ],
            "movement": {
              "kind": "budget",
              "name": "Leagues",
              "unit": "points",
              "perDay": "floor(speed / 10)",
              "forced": { "factor": 1.5, "stack": "once", "note": "The group pushes on into the dusk: half again as far today, and everyone needs rest tonight." },
              "routes": [
                { "id": "wild", "name": "Wild" },
                { "id": "causeway", "name": "Causeway", "cost": 1, "column": "causeway" },
                { "id": "channel", "name": "By channel", "cost": 2 }
              ],
              "note": "A league is an hour of steady walking on good ground."
            },
            "terrain": [
              { "id": "sedge", "name": "Sedge meadow", "cost": 2, "lostChance": [1], "wanderChance": [1], "mounts": "ride", "vehicles": true },
              { "id": "bog", "name": "Bog", "cost": 3, "lostChance": [1, 2], "wanderChance": [1, 2], "mounts": "none", "vehicles": false },
              { "id": "reedbed", "name": "Reedbed", "cost": 4, "lostChance": [1, 2, 3], "wanderChance": [1], "mounts": "lead", "vehicles": false }
            ],
            "rest": { "every": { "value": 6, "unit": "day" }, "length": { "value": 1, "unit": "day" }, "condition": "weary", "note": "Six days of walking, then a day of rest, or everyone is weary." },
            "camp": {
              "procedure": [
                { "id": "setup", "name": "Pitch camp", "icon": "camp", "kind": "note", "note": "Find a hummock above the water." },
                { "id": "watches", "name": "Set watches", "icon": "watch", "kind": "watches", "watchLength": { "value": 2, "unit": "hour" } },
                { "id": "night", "name": "Night prowlers", "icon": "monster", "kind": "check", "checkId": "fen-prowl" },
                { "id": "sleep", "name": "Sleep", "icon": "rest", "kind": "note", "note": "Sleep comes with the next part of camp." }
              ],
              "fire": { "lightTypeId": "reed-fire", "note": "Wet reeds smoke more than they burn." },
              "cooking": { "ingredients": ["bog-eel"], "portions": 2, "bonus": [{ "heal": 1 }], "note": "One eel feeds two." },
              "sleep": {
                "difficulties": [{ "id": "easy", "name": "Easy", "result": "good" }, { "id": "hard", "name": "Hard", "result": "check", "add": -1 }],
                "rows": [{ "fire": true, "difficulty": "easy" }, { "difficulty": "hard" }],
                "beddingItems": [],
                "modifiers": [{ "when": "campfire-talk", "add": 1, "note": "Campfire talk" }],
                "checkAbility": "WIS"
              }
            },
            "activities": [
              { "id": "cut-reeds", "name": "Cut reeds", "icon": "search", "cost": { "budget": 2 }, "chance": { "abilityCheck": "WIT" }, "who": "several", "maxActors": 2, "bestOf": true, "modifiers": [{ "when": "fullDay", "add": 1 }, { "who": "self", "ifClass": "reed-witch", "add": 1, "note": "A Reed Witch knows the good stands." }], "yields": { "item": "reed-bundle", "dice": "1d3" }, "onlyOnTerrain": ["reedbed", "sedge"] },
              { "id": "scout-ahead", "name": "Scout ahead", "icon": "search", "cost": { "budget": 3 }, "chance": { "abilityCheck": "WIT" }, "who": "one", "secret": true, "result": "They learn what lies in the next stretch of fen.", "note": "The GM rolls in secret and narrates." },
              { "id": "hark-for-prowlers", "name": "Hark for prowlers", "icon": "listen", "cost": { "budget": 0 }, "chance": { "skill": ["hark", "EAR"] }, "who": "several", "note": "Stand still in the reeds and listen." },
              { "id": "dig-bog-roots", "name": "Dig bog roots", "icon": "forage", "cost": { "budget": 1 }, "who": "one", "yields": { "item": "fen-rations-week", "units": "1d3" }, "onlyOnTerrain": ["bog"], "note": "Single days of food, packed like the week's rations." }
            ]
          }
        ]
      }
    }
  ],
  "fieldTemplates": [
    {
      "id": "fen-sheet",
      "name": "Fen sheet",
      "appliesTo": "pc",
      "fields": [
        { "key": "MUS", "label": "MUS", "type": "number", "group": "Abilities", "showOnCard": true },
        { "key": "NIM", "label": "NIM", "type": "number", "group": "Abilities", "showOnCard": true },
        { "key": "GRT", "label": "GRT", "type": "number", "group": "Abilities", "showOnCard": true },
        { "key": "WIT", "label": "WIT", "type": "number", "group": "Abilities", "showOnCard": true },
        { "key": "LORE", "label": "LORE", "type": "number", "group": "Abilities", "showOnCard": true },
        { "key": "CHARM", "label": "CHARM", "type": "number", "group": "Abilities", "showOnCard": true },
        { "key": "alignment", "label": "Leaning", "type": "list", "choices": ["Lantern", "Reed", "Mire"], "group": "Who they are", "required": true },
        { "key": "ac", "label": "Armour", "type": "number", "group": "Fight", "fill": "ac" },
        { "key": "hp", "label": "Hit points", "type": "number", "group": "Fight", "required": true },
        { "key": "movement", "label": "Movement", "type": "text", "group": "Fight", "fill": "movement" },
        { "key": "attack", "label": "Attack", "type": "number", "group": "Fight", "fill": "attack" },
        { "key": "saveMire", "label": "Save vs mire", "type": "number", "group": "Saves", "fill": "saves.mire" },
        { "key": "title", "label": "Title", "type": "text", "group": "Who they are", "fill": "title" },
        { "key": "literacy", "label": "Literacy", "type": "text", "group": "Who they are", "fill": "abilityModifiers.WIT.literacy" },
        { "key": "languages", "label": "Languages", "type": "text", "group": "Who they are" },
        { "key": "background", "label": "Background", "type": "list", "group": "Who they are", "from": "fen-backgrounds-{race}" },
        { "key": "omen", "label": "Omen", "type": "list", "group": "Who they are", "from": "fen-omens", "option": "fen-omens" },
        { "key": "motto", "label": "Motto", "type": "text", "group": "Who they are" },
        { "key": "affiliation", "label": "Affiliation", "type": "text", "group": "Who they are", "help": "The band your character answers to, if any. It comes from play, not from creation.", "atCreation": false },
        { "key": "hark", "label": "Hark", "type": "number", "group": "Skills", "fill": "skills.hark" },
        { "key": "spellWard", "label": "Spell ward", "type": "number", "group": "Saves", "fill": "saveModifiers.spell-ward" }
      ]
    }
  ],
  "options": [
    {
      "id": "creation-path",
      "name": "How characters are made",
      "ruleKey": "creation-method",
      "default": "players-choose",
      "changeLater": "allow",
      "choices": [
        { "id": "players-choose", "name": "Each player chooses", "short": "Players pick", "methods": ["kindred-first", "calling-only"] },
        { "id": "kindred-first", "name": "Kindred, then calling", "short": "Kindred first", "races": "required" },
        { "id": "calling-only", "name": "Calling as kindred", "short": "Calling only", "races": "none" }
      ],
      "notes": "Whether players pick a kindred and a calling, or a calling that is also their kindred."
    },
    {
      "id": "fen-omens",
      "name": "Birth omens",
      "default": "off",
      "changeLater": "allow",
      "choices": [
        { "id": "off", "name": "Off", "notes": "No omens." },
        { "id": "on", "name": "On", "notes": "Each character rolls or picks the omen they were born under." }
      ],
      "notes": "Adds a birth omen to each character, rolled or picked at creation."
    },
    {
      "id": "fen-second-wind",
      "name": "Second wind",
      "default": "on",
      "changeLater": "allow",
      "choices": [
        { "id": "off", "name": "Off", "notes": "The hit points rolled stand." },
        { "id": "on", "name": "On", "notes": "A 1 or 2 on the hit-points die may be rolled again." }
      ],
      "notes": "Whether a very low hit-points roll at creation may be rolled again."
    },
    {
      "id": "fen-market",
      "name": "Fen market",
      "default": "on",
      "changeLater": "allow",
      "choices": [
        { "id": "off", "name": "Off", "notes": "No shop at creation: everyone starts with a reed rope and a storm lantern, plus their kit." },
        { "id": "on", "name": "On", "notes": "Buy starting gear at the market." }
      ],
      "notes": "Whether new characters buy their gear or start with the market's bundle."
    },
    {
      "id": "fen-kin-callings",
      "name": "Kin callings",
      "default": "off",
      "changeLater": "allow",
      "choices": [
        { "id": "off", "name": "Off", "notes": "Only the usual callings." },
        { "id": "on", "name": "On", "notes": "A kindred may also be taken as a calling of its own." }
      ],
      "notes": "Whether the kin callings (a kindred played as its own calling) are offered."
    },
    {
      "id": "fen-kin-limits",
      "name": "Kindred limits",
      "default": "kept",
      "changeLater": "warn",
      "category": "Character creation",
      "choices": [
        { "id": "kept", "name": "Kept", "notes": "Each kindred takes only its own callings, to the levels it lists." },
        { "id": "chaplains-npc", "name": "Chaplains are the GM's", "notes": "As kept, and the marsh chaplains of every kindred are the GM's characters only.", "short": "Chaplains NPC" },
        { "id": "lifted", "name": "Lifted", "notes": "Any kindred may take any calling, to any level." }
      ],
      "notes": "Whether a kindred's calling and level limits apply (invented, for the class-limit tests; cs-5)."
    },
    {
      "id": "fen-quick-kit",
      "name": "Quick bundle",
      "default": "off",
      "changeLater": "allow",
      "choices": [
        { "id": "off", "name": "Off", "notes": "Only the callings' own kits." },
        { "id": "on", "name": "On", "notes": "Anyone may take the quick bundle instead of shopping." }
      ],
      "notes": "Whether the quick bundle is offered at creation."
    },
    {
      "id": "fen-weapon-drill",
      "name": "Weapon drill",
      "default": "off",
      "changeLater": "allow",
      "choices": [
        { "id": "off", "name": "Off", "short": "Off", "notes": "Any weapon, no drill." },
        { "id": "on", "name": "On", "short": "On", "notes": "Callings drill with a few weapons." },
        { "id": "on-drill-master", "name": "On, with a master weapon", "short": "With master", "notes": "Drill, and one weapon may be mastered." }
      ],
      "notes": "Whether characters pick the weapons they drilled with, and whether one may be mastered."
    },
    {
      "id": "fen-odd-weapons",
      "name": "Odd weapons",
      "default": "off",
      "changeLater": "allow",
      "choices": [
        { "id": "off", "name": "Off", "notes": "A calling's forbidden weapons stay forbidden." },
        { "id": "on", "name": "On", "notes": "Forbidden weapons may be used, clumsily." }
      ],
      "notes": "Whether a calling may use the weapons it isn't drilled for."
    },
    {
      "id": "fen-small-charms",
      "name": "Small charms",
      "default": "off",
      "changeLater": "allow",
      "choices": [
        { "id": "off", "name": "Off", "notes": "No small charms." },
        { "id": "on", "name": "On", "notes": "Cantors know small charms from the start." }
      ],
      "notes": "Whether cantors start knowing small charms."
    },
    {
      "id": "fen-cruel-dice",
      "name": "Cruel dice",
      "default": "on",
      "changeLater": "allow",
      "choices": [
        { "id": "off", "name": "Off", "notes": "The scores rolled stand." },
        { "id": "on", "name": "On", "notes": "Very low scores may be rolled again." }
      ],
      "notes": "Whether a player may start over after very low scores."
