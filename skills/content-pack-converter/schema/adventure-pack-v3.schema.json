     "items": {
      "type": "integer"
     }
    }
   }
  },
  "optionLink": {
   "type": "string",
   "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(=[a-z0-9]+(-[a-z0-9]+)*)?$"
  },
