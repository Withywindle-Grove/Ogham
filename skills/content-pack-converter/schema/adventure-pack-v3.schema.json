   "type": "array",
   "description": "GM reference panels at the pack's top level (07, Format additions from the zine-compendium survey, G-55; ruled 2026-11-01): [{ id, title, entries: [{ heading, text, tableId?, source? }] }]",
   "items": {
    "type": "object",
    "required": [
     "id",
     "title",
     "entries"
    ],
    "additionalProperties": true,
    "properties": {
     "id": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "entries": {
      "type": "array",
