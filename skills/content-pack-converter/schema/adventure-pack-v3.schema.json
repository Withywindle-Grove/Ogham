{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "tabletop-pack, format version 3 (adventure kinds)",
 "description": "Written from docs/07-content-packs.md, Adventure packs (format version 3), ruled 2026-10-24. Used by the converter until M8b's importer exists. Where this file and 07 differ, 07 wins. The v3 kinds list their fields so unknown ones show as off-spec; v1/v2 kinds are only checked for an id here (npm run pack:check checks them).",
 "type": "object",
 "required": [
  "format",
  "formatVersion",
  "meta"
 ],
 "additionalProperties": false,
 "properties": {
  "format": {
   "const": "tabletop-pack"
  },
  "formatVersion": {
