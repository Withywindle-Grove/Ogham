     "$ref": "#/$defs/id"
    },
    {
     "type": "null"
    }
   ]
  },
  "texts": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "time": {
   "type": "object",
   "required": [
    "value",
    "unit"
   ],
   "additionalProperties": false,
   "properties": {
    "value": {
     "type": "integer"
    },
    "unit": {
     "type": "string"
    }
   }
  },
  "chance": {
